{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky ToDo",
  "version": "1.0.0",
  "identifier": "jp.athena.stickytodo",
  "build": { "frontendDist": "../dist", "devUrl": "http://127.0.0.1:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Sticky ToDo", "width": 1240, "height": 820, "minWidth": 880, "minHeight": 620, "resizable": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": ["nsis"] }
}
